# .env Template
# Copy this to .env and fill in your values

# AWS Configuration
AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_DEFAULT_REGION=us-east-1

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_KB_ID=kb-xxxxx  # Set after creating Bedrock KB

# S3 Configuration (for knowledge base documents)
S3_BUCKET=geekbrain-kb-us-east-1

# OpenSearch Configuration
OPENSEARCH_ENDPOINT=https://xxxxx.aoss.amazonaws.com
OPENSEARCH_COLLECTION=geekbrain-kb

# Database Configuration
DB_TYPE=sqlite
SQLITE_PATH=data_package/geekbrain.db
# For PostgreSQL, uncomment and set:
# DB_TYPE=postgres
# POSTGRES_URL=postgresql://user:password@localhost/geekbrain

# Monitoring API Configuration
MONITORING_API_BASE=http://localhost:8000
MONITORING_API_TIMEOUT=5

# RAG Configuration
RETRIEVAL_K=10
HYBRID_SEARCH=true

# LLM Configuration
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000

# Memory Configuration (L4)
MEMORY_MAX_TURNS=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_JSON=false

# Mode Configuration
# Options: mock (dev, no AWS), local (local KB), cloud (AWS Bedrock KB)
MODE=local
